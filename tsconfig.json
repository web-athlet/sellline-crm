{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@web/*": ["apps/web/*"],
      "@api/*": ["apps/api/src/*"],
      "@sellline/shared-types": ["packages/shared-types/src/index.ts"],
      "@sellline/shared-types/*": ["packages/shared-types/src/*"],
      "@sellline/ui-components": ["packages/ui-components/src/index.ts"]
    }
  },
  "exclude": ["**/node_modules", "**/dist", "**/.next", "**/.turbo", "**/coverage"]
}
