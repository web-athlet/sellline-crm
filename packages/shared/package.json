{
  "name": "@sellline/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./env/web": {
      "types": "./dist/env/web.d.ts",
      "import": "./dist/env/web.js",
      "require": "./dist/env/web.cjs"
    },
    "./env/api": {
      "types": "./dist/env/api.d.ts",
      "import": "./dist/env/api.js",
      "require": "./dist/env/api.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@sellline/config-eslint": "workspace:*",
    "@sellline/config-typescript": "workspace:*",
    "@types/node": "^20.16.11",
    "eslint": "^9.12.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.5"
  }
}
