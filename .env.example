# =============================================================================
# sellline-CRM — Environment Contract
# Copy to .env and fill values. Validated at boot by apps/web and apps/api
# against Zod schemas from @sellline/shared.
# =============================================================================

# ---- Core ----
NODE_ENV=development

# ---- Database (Postgres 15 + pgvector) ----
DATABASE_URL=postgresql://sellline:sellline@localhost:5432/sellline?schema=public
POSTGRES_USER=sellline
POSTGRES_PASSWORD=sellline
POSTGRES_DB=sellline

# ---- Redis (cache + BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (NextAuth v5 ↔ NestJS shared JWT) ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-prod-please
AUTH_JWT_SECRET=change-me-in-prod-please
AUTH_JWT_REFRESH_SECRET=change-me-in-prod-please
AUTH_JWT_ISSUER=sellline-web
AUTH_JWT_AUDIENCE=sellline-api
AUTH_JWT_EXPIRES_IN=1h
AUTH_JWT_REFRESH_EXPIRES_IN=30d

# ---- OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- DSGVO / E-Mail-Verschlüsselung ----
# 32-byte hex key used for AES-256-GCM (generate with: openssl rand -hex 32)
EMAIL_ENCRYPTION_KEY=

# ---- Campaign delivery ----
SENDGRID_API_KEY=

# ---- PWA Push (VAPID) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Gmail Pub/Sub (Session 11) ----
GCP_PUBSUB_PROJECT=
GCP_PUBSUB_TOPIC=gmail-notifications

# ---- Observability ----
SENTRY_DSN=

# ---- API (NestJS) ----
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
API_CORS_ORIGIN=http://localhost:3000

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# Alias kept for historical references in docs; points to the same Socket.io endpoint as NEXT_PUBLIC_WS_URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ---- Storage (MinIO / S3-compatible) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sellline-assets
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- AI ----
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_EMBED=text-embedding-3-small

# ---- Web Search ----
SERPER_API_KEY=

# ---- Mail (dev → mailhog) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sellline.local

# ---- Logging ----
LOG_LEVEL=debug
